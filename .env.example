# Copy to .env and fill in. .env is gitignored.

# Required — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — where ChromaDB persists its collection.
# Defaults to ./chroma_db, regenerated by pipeline/ingest.py.
CHROMA_PERSIST_DIR=chroma_db

# Which model vendor to use. Only "anthropic" is implemented — adding another
# means one class in app/provider.py, not a rewrite of app/llm.py.
LLM_PROVIDER=anthropic

# Generation model id, passed straight through to the provider.
GENERATION_MODEL=claude-sonnet-4-5
